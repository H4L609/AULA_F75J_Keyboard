#!/usr/bin/env python3
"""Windows 用の `cc` の代わり。

SMK のビルド（meson.build）は、PC 側で動く小さな補助プログラム
（utils/led_geometry_gen.c）を `cc -O2 -o <出力> <ソース>` で作ろうとする。
Windows には cc がないので、この引数を MSVC の cl に読み替えて実行する。
meson がビルドの準備をするときに、Visual Studio の環境を読み込むので cl が使える。
"""
import os
import subprocess
import sys

args = sys.argv[1:]
out = None
srcs = []
i = 0
while i < len(args):
    a = args[i]
    if a == '-o':
        out = args[i + 1]
        i += 2
        continue
    if not a.startswith('-'):
        srcs.append(a)
    i += 1

if out is None or not srcs:
    sys.exit('hostcc: usage: cc -O2 -o <out> <src...>')

exe = out if out.lower().endswith('.exe') else out + '.exe'
objdir = os.path.dirname(os.path.abspath(exe))
r = subprocess.run(['cl', '/nologo', '/O2', '/std:c11', f'/Fe:{exe}', f'/Fo:{objdir}\\'] + srcs)
sys.exit(r.returncode)
